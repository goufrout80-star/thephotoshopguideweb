# Copy this file to .env and fill in real values. Never commit .env.

# --- Supabase (contact form) ---
# Create a project at supabase.com, run supabase/schema.sql in its SQL editor,
# then paste the values from Project Settings > API here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Analytics (optional) ---
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Leave blank to disable analytics entirely.
VITE_GA_MEASUREMENT_ID=
